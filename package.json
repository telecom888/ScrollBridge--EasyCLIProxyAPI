{
  "name": "scrollbridge",
  "productName": "卷桥",
  "version": "0.1.4",
  "description": "本地模型服务的域名与 HTTPS 隧道桌面工具",
  "author": "telecom888",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "vendor": "node scripts/vendor.cjs",
    "dist": "npm run check && npm test && electron-builder --win portable --x64"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "io.scrollbridge.desktop",
    "asar": true,
    "files": [
      "electron/**",
      "lib/**",
      "ui/**",
      "licenses/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "icon": "design/app.ico"
    },
    "portable": {
      "artifactName": "ScrollBridge-${version}-win-x64.exe"
    }
  }
}
