{
  "name": "scrollbridge",
  "productName": "卷桥",
  "version": "0.3.27",
  "description": "本地模型服务的域名与 HTTPS 隧道桌面工具",
  "author": "telecom888",
  "license": "GPL-3.0-only",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "vendor": "node scripts/vendor.cjs",
    "dist": "npm run check && npm test && npm run test:go && node scripts/build-desktop.cjs go --skip-core-build",
    "dist:node": "node scripts/build-desktop.cjs node",
    "dist:go": "node scripts/build-desktop.cjs go",
    "dist:both": "node scripts/build-desktop.cjs both",
    "test:go": "node scripts/test-go.cjs"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "io.scrollbridge.desktop",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "electron/**",
      "lib/**",
      "ui/**",
      "licenses/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis",
        "zip"
      ],
      "signExecutable": false,
      "icon": "design/app.ico"
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "ScrollBridge-${version}-win-x64.exe"
    }
  },
  "gatewayEngine": "go",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telecom888/ScrollBridge--EasyCLIProxyAPI.git"
  }
}
